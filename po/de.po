#: crates/zfs-toolbox/src/helper_client.rs:33
msgid "Authentication was cancelled."
msgstr "Die Authentifizierung wurde abgebrochen."

#: crates/zfs-toolbox/src/helper_client.rs:34
msgid "Administrator authentication failed."
msgstr "Die Administrator-Authentifizierung ist fehlgeschlagen."

#: crates/zfs-toolbox/src/helper_client.rs:36
msgid "The administration helper is not installed ({})."
msgstr "Das Verwaltungshilfsprogramm ist nicht installiert ({})."

