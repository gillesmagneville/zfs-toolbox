msgstr "Der ZFS-Befehl ist fehlgeschlagen."

#: crates/zfs-toolbox/src/helper_client.rs:52
msgid "Unexpected error: {}"
msgstr "Unerwarteter Fehler: {}"

#: crates/zfs-toolbox/src/main.rs:20
msgid "Manage OpenZFS pools, datasets, snapshots and replication"
msgstr "OpenZFS-Pools, Datasets, Snapshots und Replikation verwalten"

#: crates/zfs-toolbox/src/overview.rs:44
msgid "Online"
msgstr "Online"

#: crates/zfs-toolbox/src/overview.rs:45
msgid "Degraded"
msgstr "Herabgesetzt"

#: crates/zfs-toolbox/src/overview.rs:46
msgid "Faulted"
msgstr "Fehlerhaft"

#: crates/zfs-toolbox/src/overview.rs:47
msgid "Offline"
msgstr "Offline"

#: crates/zfs-toolbox/src/overview.rs:48
msgid "Unavailable"
msgstr "Nicht verfügbar"

#: crates/zfs-toolbox/src/overview.rs:49
msgid "Removed"
msgstr "Entfernt"

#: crates/zfs-toolbox/src/overview.rs:50
msgid "Suspended"
msgstr "Angehalten"

#: crates/zfs-toolbox/src/overview.rs:87
msgid "The status check crashed."
msgstr "Die Statusprüfung ist abgestürzt."

#: crates/zfs-toolbox/src/overview.rs:96
msgid "OpenZFS is not installed"
msgstr "OpenZFS ist nicht installiert"

#: crates/zfs-toolbox/src/overview.rs:98
msgid ""
"Install the OpenZFS tools (the zfsutils-linux package on Debian and Ubuntu, "
"the zfs package on Red Hat and derivatives), then refresh."
msgstr ""
"Installieren Sie die OpenZFS-Werkzeuge (Paket zfsutils-linux unter Debian "
"und Ubuntu, Paket zfs unter Red Hat und Derivaten) und aktualisieren Sie "
"anschließend."

#: crates/zfs-toolbox/src/overview.rs:104
msgid "Could not read the OpenZFS status"
msgstr "Der OpenZFS-Status konnte nicht gelesen werden"

#: crates/zfs-toolbox/src/overview.rs:122
msgid "Unknown"
msgstr "Unbekannt"

#: crates/zfs-toolbox/src/overview.rs:130
msgid "Not loaded"
msgstr "Nicht geladen"

#: crates/zfs-toolbox/src/overview.rs:133
msgid "Tools version"
msgstr "Version der Werkzeuge"

#: crates/zfs-toolbox/src/overview.rs:134
msgid "Kernel module"
msgstr "Kernelmodul"

#: crates/zfs-toolbox/src/overview.rs:139 crates/zfs-toolbox/src/window.rs:22
msgid "Pools"
msgstr "Pools"

#: crates/zfs-toolbox/src/overview.rs:143
msgid "Could not list the pools"
msgstr "Die Pools konnten nicht aufgelistet werden"

#: crates/zfs-toolbox/src/overview.rs:146
msgid "No imported pool"
msgstr "Kein importierter Pool"

#: crates/zfs-toolbox/src/overview.rs:151
msgid "{} imported pool"
msgid_plural "{} imported pools"
msgstr[0] "{} importierter Pool"
msgstr[1] "{} importierte Pools"

#: crates/zfs-toolbox/src/overview.rs:158
msgid "{} used of {}"
msgstr "{} von {} belegt"

#: crates/zfs-toolbox/src/overview.rs:177
msgid "Administrator access"
msgstr "Administratorzugriff"

#: crates/zfs-toolbox/src/overview.rs:179
msgid "Operations that change your pools ask for an administrator password."
msgstr ""
"Vorgänge, die Ihre Pools verändern, erfordern ein Administratorpasswort."

#: crates/zfs-toolbox/src/overview.rs:183
msgid "Test"
msgstr "Testen"

#: crates/zfs-toolbox/src/overview.rs:187
msgid "Check administrator access"
msgstr "Administratorzugriff prüfen"

#: crates/zfs-toolbox/src/overview.rs:209
msgid "Administrator access works."
msgstr "Der Administratorzugriff funktioniert."

#: crates/zfs-toolbox/src/overview.rs:211
msgid "The administration helper crashed."
msgstr "Das Verwaltungshilfsprogramm ist abgestürzt."

#: crates/zfs-toolbox/src/window.rs:24
msgid "Create, import, export and inspect storage pools."
msgstr "Speicherpools erstellen, importieren, exportieren und untersuchen."

#: crates/zfs-toolbox/src/window.rs:28
msgid "Datasets"
msgstr "Datasets"

#: crates/zfs-toolbox/src/window.rs:31
msgid ""
"Manage filesystems and volumes, mount them and load their encryption keys."
msgstr ""
"Dateisysteme und Volumes verwalten, einhängen und ihre "
"Verschlüsselungsschlüssel laden."

#: crates/zfs-toolbox/src/window.rs:36
msgid "Snapshots"
msgstr "Snapshots"

#: crates/zfs-toolbox/src/window.rs:38
msgid "Take snapshots and schedule them with a retention policy."
msgstr "Snapshots erstellen und mit einer Aufbewahrungsrichtlinie planen."

#: crates/zfs-toolbox/src/window.rs:42
msgid "Replication"
msgstr "Replikation"

#: crates/zfs-toolbox/src/window.rs:44
msgid "Copy datasets to another pool or another server."
msgstr ""
"Datasets in einen anderen Pool oder auf einen anderen Server kopieren."

#: crates/zfs-toolbox/src/window.rs:48
msgid "Health"
msgstr "Zustand"

#: crates/zfs-toolbox/src/window.rs:50
msgid "Follow the state of your disks and run scrubs."
msgstr "Den Zustand Ihrer Festplatten verfolgen und Scrubs ausführen."

#: crates/zfs-toolbox/src/window.rs:64
msgid "Overview"
msgstr "Übersicht"

#: crates/zfs-toolbox/src/window.rs:73
msgid "This section will be available in a future version."
msgstr "Dieser Bereich wird in einer zukünftigen Version verfügbar sein."

#: crates/zfs-toolbox/src/window.rs:92
msgid "Refresh"
msgstr "Aktualisieren"

#: crates/zfs-toolbox/src/window.rs:95
msgid "About ZFS Toolbox"
msgstr "Über ZFS Toolbox"

#: crates/zfs-toolbox/src/window.rs:96
msgid "Quit"
msgstr "Beenden"

#: crates/zfs-toolbox/src/window.rs:100
msgid "Main menu"
msgstr "Hauptmenü"

#. Translators: search terms, separated and terminated by semicolons.
#: data/io.github.gillesmagneville.ZfsToolbox.desktop.in:7
msgid ""
"zfs;zpool;openzfs;pool;dataset;snapshot;backup;replication;storage;disk;"
msgstr ""
"zfs;zpool;openzfs;Pool;Dataset;Snapshot;Sicherung;Backup;Replikation;Speicher;Festplatte;"

#: data/io.github.gillesmagneville.ZfsToolbox.metainfo.xml.in:10
msgid "ZFS Toolbox is a desktop application to manage OpenZFS on Linux."
msgstr ""
"ZFS Toolbox ist eine Desktop-Anwendung zur Verwaltung von OpenZFS unter "
"Linux."

#: data/io.github.gillesmagneville.ZfsToolbox.metainfo.xml.in:12
msgid "Create and inspect pools and datasets"
msgstr "Pools und Datasets erstellen und untersuchen"

#: data/io.github.gillesmagneville.ZfsToolbox.metainfo.xml.in:13
msgid "Take snapshots and keep them according to a retention policy"
msgstr "Snapshots erstellen und gemäß einer Aufbewahrungsrichtlinie behalten"

#: data/io.github.gillesmagneville.ZfsToolbox.metainfo.xml.in:14
msgid "Replicate datasets to another pool or another server"
msgstr ""
"Datasets in einen anderen Pool oder auf einen anderen Server replizieren"

#: data/io.github.gillesmagneville.ZfsToolbox.metainfo.xml.in:15
msgid "Follow the health of your disks and run scrubs"
msgstr "Den Zustand Ihrer Festplatten verfolgen und Scrubs ausführen"

#: data/io.github.gillesmagneville.ZfsToolbox.metainfo.xml.in:16
msgid "Mount datasets and load their encryption keys"
msgstr "Datasets einhängen und ihre Verschlüsselungsschlüssel laden"

#: data/io.github.gillesmagneville.ZfsToolbox.policy.in:11
msgid "Manage ZFS pools and datasets"
msgstr "ZFS-Pools und -Datasets verwalten"

#: data/io.github.gillesmagneville.ZfsToolbox.policy.in:12
msgid "Authentication is required to manage ZFS pools and datasets"
msgstr ""
"Zur Verwaltung von ZFS-Pools und -Datasets ist eine Authentifizierung "
"erforderlich"
