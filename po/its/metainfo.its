<?xml version="1.0"?>
<its:rules xmlns:its="http://www.w3.org/2005/11/its" version="2.0">
  <its:translateRule selector="/component" translate="no"/>
  <its:translateRule selector="/component/name | /component/summary | /component/description | /component/releases/release/description | /component/keywords/keyword" translate="yes"/>
  <its:translateRule selector="//*[@translatable = 'no']" translate="no"/>
  <its:translateRule selector="//*[@translatable = 'no']//*" translate="no"/>
  <its:withinTextRule selector="/component/description//em | /component/description//code" withinText="yes"/>
</its:rules>
